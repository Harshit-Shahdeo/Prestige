generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum ReviewSessionStatus {
  STARTED
  RATED
  FEEDBACK_RECEIVED
  PROCESSING
  DRAFT_READY
  CONFIRMED
  HANDED_OFF
}

enum Sentiment {
  GOOD
  BAD
}

enum ReviewDraftStatus {
  PROCESSING
  READY
  CONFIRMED
  FAILED
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  locations      Location[]
  keywords       Keyword[]
  reviewSessions ReviewSession[]
}

model Location {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  address   String
  timezone  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tables         Table[]
  reviewSessions ReviewSession[]

  @@index([tenantId])
}

model Table {
  id          String   @id @default(cuid())
  locationId  String
  tableNumber String
  qrToken     String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location       Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  reviewSessions ReviewSession[]

  @@unique([locationId, tableNumber])
  @@index([locationId])
}

model ReviewSession {
  id         String              @id @default(cuid())
  tenantId   String
  locationId String
  tableId    String
  status     ReviewSessionStatus @default(STARTED)
  rating     Int?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  table    Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)

  feedback    Feedback?
  reviewDraft ReviewDraft?

  @@index([tenantId])
  @@index([locationId])
  @@index([tableId])
  @@index([tenantId, createdAt])
}

model Feedback {
  id        String   @id @default(cuid())
  sessionId String   @unique
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session  ReviewSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  keywords FeedbackKeyword[]
}

model Keyword {
  id       String @id @default(cuid())
  tenantId String
  name     String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  feedbackKeywords FeedbackKeyword[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model FeedbackKeyword {
  feedbackId String
  keywordId  String
  sentiment  Sentiment

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  keyword  Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([feedbackId, keywordId])
  @@index([keywordId])
}

model ReviewDraft {
  id        String            @id @default(cuid())
  sessionId String            @unique
  rawText   String
  text      String
  status    ReviewDraftStatus @default(PROCESSING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  session ReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
